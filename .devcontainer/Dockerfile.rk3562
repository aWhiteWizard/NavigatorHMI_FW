# ============================================================
# NavigatorHMI RK3562 交叉编译环境镜像 (ubuntu 20.04)
# 镜像: swr.cn-southwest-2.myhuaweicloud.com/image-linuxenv/rk3562-builder-env:v1.0-ubuntu20
#
# 设计要点 (2026-08-14):
#   - 只装编译依赖; SDK 源码(17.8GB)与交叉工具链不打进镜像,
#     通过卷挂载 /sdk 提供 (迅为 6.1 SDK 的 buildroot 用相对路径
#     $(TOPDIR)/../prebuilts/... 引用工具链, buildroot 位于 /sdk/buildroot 时自动解析)
#   - 依赖清单源自迅为官方 install.sh (02_开发工具/01_搭建虚拟机Ubuntu环境配套资料/
#     03_原始虚拟机镜像/install.sh), 已适配 ubuntu 20.04 (focal):
#       移除 openjdk-8-jdk      (focal 无此包, buildroot 编译不需要 java)
#       移除 libesd-java        (esound 已废弃, focal 无此包)
#       移除 liblz-dev          (无此包名)
#       移除 android-sdk-ext4-utils (focal 移除, 由 android-sdk-libsparse-utils 覆盖)
#       保留 android-sdk-libsparse-utils (focal universe 存在, 镜像打包用)
# ============================================================
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    FORCE_UNSAFE_CONFIGURE=1

# 国内镜像源(清华, https) + 关闭 apt TLS 证书验证 + 时区
# 网络说明: 本机经代理(TUN, 198.18.x.x), 仅放行 443; 代理做 TLS 中间人,
# 容器内证书不受信 -> https 源 + Acquire::https::Verify-Peer false
RUN sed -i 's|http://archive.ubuntu.com/ubuntu/|https://mirrors.tuna.tsinghua.edu.cn/ubuntu/|g; s|http://security.ubuntu.com/ubuntu/|https://mirrors.tuna.tsinghua.edu.cn/ubuntu/|g' /etc/apt/sources.list \
 && echo 'Acquire::https::Verify-Peer "false";' > /etc/apt/apt.conf.d/99verify-peer-off \
 && apt-get update \
 && apt-get install -y --no-install-recommends tzdata ca-certificates \
 && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
 && dpkg-reconfigure -f noninteractive tzdata

# 编译依赖 (核心清单, 必须全部成功)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ gcc-multilib g++-multilib \
    lib32z1-dev lib32ncurses-dev lib32readline-dev \
    libc6-dev libncurses5-dev libncursesw5-dev \
    libssl-dev libelf-dev zlib1g-dev uuid uuid-dev libicu-dev \
    git curl wget ssh rsync vim expect \
    u-boot-tools mtd-utils device-tree-compiler gdisk \
    flex bison gperf gawk texinfo diffstat chrpath patchelf \
    make cmake python3 python3-pip python-is-python2 \
    qemu-user-static binfmt-support fakeroot \
    lzop lz4 liblz4-tool squashfs-tools zip unzip \
    liblzo2-2 liblzo2-dev liblzma-dev \
    libsdl1.2-dev libglib2.0-dev libswitch-perl \
    pngcrush schedtool m4 bzr cvs subversion mercurial \
    binutils cpio file bc \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 辅助依赖 (universe 包, 个别缺失不影响核心编译)
RUN apt-get update && apt-get install -y --no-install-recommends \
    android-sdk-libsparse-utils libxml2 libxml2-utils xsltproc \
    || true \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["/bin/bash"]
